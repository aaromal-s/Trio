# ============================================================================
# TRIO Backend Environment Configuration
# Copy this file to .env and fill in production values.
# ============================================================================

# --- Environment ---
ENVIRONMENT=development
# Set to 'production' on Render/cloud deployment

# --- Database ---
# SQLite (default for local development):
DATABASE_URL=sqlite:///trio.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/trio_db

# --- Redis (optional, for multi-worker rate limiting) ---
# REDIS_URL=redis://localhost:6379/0
# Leave empty to use in-memory rate limiter (fine for single-worker)

# --- Email Provider (choose one) ---
# Resend (recommended):
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# SendGrid:
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# Email sender address:
EMAIL_FROM=TRIO <noreply@trio-ai.dev>

# Frontend URL for password-reset links:
FRONTEND_URL=http://localhost:5173
# Production: https://your-app.vercel.app

# --- CORS ---
# Comma-separated allowed origins for production:
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# --- Security ---
# Secret key for JWT (future use):
# SECRET_KEY=your-random-secret-key-here

