# AegisOps AI Configuration Environment Example

# Application
PROJECT_NAME="AegisOps AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security (Change in Production!)
SECRET_KEY="aegisops_enterprise_production_secret_key_change_in_prod_9876543210"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local portable standalone: sqlite:///./aegisops.db
# Containerized PostgreSQL: postgresql://aegisops:aegisops_secure_password_2026@localhost:5432/aegisops_db
DATABASE_URL="sqlite:///./aegisops.db"

# Telemetry
TELEMETRY_REFRESH_INTERVAL_SECONDS=5

# Frontend
VITE_API_BASE_URL="http://localhost:8000/api/v1"
