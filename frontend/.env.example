# AegisOps AI Frontend Environment Configuration

# Base URL pointing to the FastAPI backend API (including /api/v1)
# For local development with Vite dev server:
VITE_API_BASE_URL=http://localhost:8000/api/v1

# For production deployment on Vercel pointing to AWS App Runner:
# VITE_API_BASE_URL=https://your-app-runner-id.us-east-1.awsapprunner.com/api/v1

# For single-domain reverse proxy or Nginx setup (relative URL):
# VITE_API_BASE_URL=/api/v1
