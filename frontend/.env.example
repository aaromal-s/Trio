# ============================================================================
# TRIO Frontend Environment Configuration
# ============================================================================

# Primary API Base URL (must end with /api):
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Production on Vercel (points to deployed Render backend):
# VITE_API_BASE_URL=https://trio-backend.onrender.com/api

# Note: VITE_API_URL is also supported as an alias.
# If /api is omitted, the frontend automatically appends /api.
